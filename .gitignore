# --- Data (raw data is not redistributed; download it from Kaggle) ---
data/raw/*
data/interim/*
!data/raw/.gitkeep
!data/interim/.gitkeep
# Processed CSVs are large; keep them out of git (regenerate with `python -m src.main`)
data/processed/*
!data/processed/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.env
.pytest_cache/
.ipynb_checkpoints/

# --- Logs ---
logs/
*.log

# --- Power BI temp files ---
powerbi/*.pbix.bak
~$*

# --- OS / IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Power BI Project (.pbip): keep the model/report definition, ignore local cache ---
powerbi/**/.pbi/localSettings.json
powerbi/**/.pbi/cache.abf
